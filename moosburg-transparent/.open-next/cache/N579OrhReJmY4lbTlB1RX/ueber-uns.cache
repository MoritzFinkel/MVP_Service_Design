{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/ueber-uns/layout,_N_T_/ueber-uns/page,_N_T_/ueber-uns"},"segmentPaths":["/_tree","/_full","/ueber-uns/__PAGE__","/ueber-uns","/_index","/_head"]},"html":"<!DOCTYPE html><!--N579OrhReJmY4lbTlB1RX--><html lang=\"de\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" href=\"/_next/static/media/47fe1b7cd6e6ed85-s.p.855a563b.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/83afe278b6a6bb3c-s.p.3a6ba036.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/8e6fa89aa22d24ec-s.p.3aec397d.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"preload\" href=\"/_next/static/media/e2334d715941921e-s.p.d82a9aff.woff2\" as=\"font\" crossorigin=\"\" type=\"font/woff2\"/><link rel=\"stylesheet\" href=\"/_next/static/chunks/4ae24185855008a5.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/cbd55ab9639e1e66.js\"/><script src=\"/_next/static/chunks/aa0a7c5c022cbeb9.js\" async=\"\"></script><script src=\"/_next/static/chunks/cc759f7c2413b7ff.js\" async=\"\"></script><script src=\"/_next/static/chunks/4dd28bc3f722184a.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-492cd776fed59e0e.js\" async=\"\"></script><script src=\"/_next/static/chunks/8db7249337818e60.js\" async=\"\"></script><script src=\"/_next/static/chunks/ff1a16fafef87110.js\" async=\"\"></script><script src=\"/_next/static/chunks/7340adf74ff47ec0.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>Moosburg Transparent - Verstehen, was entschieden wird</title><meta name=\"description\" content=\"Die digitale Plattform für transparente Stadtratsentscheidungen in Moosburg. Einfach verständlich, barrierefrei und bürgernah.\"/><link rel=\"icon\" href=\"/favicon.ico?favicon.0b3bf435.ico\" sizes=\"256x256\" type=\"image/x-icon\"/><script src=\"/_next/static/chunks/a6dad97d9634a72d.js\" noModule=\"\"></script></head><body class=\"inter_7a7ef1f4-module__jjo8ZG__variable poppins_f08ea3ad-module__mErFHW__variable antialiased min-h-screen flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"bg-[var(--primary)] text-white sticky top-0 z-50 shadow-md\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\"><div class=\"flex items-center justify-between h-16\"><a class=\"flex items-center gap-2\" href=\"/\"><div class=\"w-10 h-10 bg-white rounded-lg flex items-center justify-center\"><span class=\"text-[var(--primary)] font-bold text-xl\">M</span></div><div class=\"hidden sm:block\"><h1 class=\"font-bold text-lg leading-tight\" style=\"font-family:Poppins, sans-serif\">Moosburg Transparent</h1><p class=\"text-xs text-[var(--secondary)] opacity-90\">Verstehen, was entschieden wird</p></div></a><nav class=\"hidden md:flex items-center gap-6\"><a class=\"hover:text-[var(--accent)] transition-colors font-medium\" href=\"/\">Dashboard</a><a class=\"hover:text-[var(--accent)] transition-colors font-medium\" href=\"/antraege\">Alle Anträge</a><a class=\"hover:text-[var(--accent)] transition-colors font-medium\" href=\"/karte\">Stadtkarte</a><a class=\"hover:text-[var(--accent)] transition-colors font-medium\" href=\"/abstimmungen\">Abstimmungen</a><a class=\"hover:text-[var(--accent)] transition-colors font-medium\" href=\"/ueber-uns\">Über uns</a></nav><button class=\"md:hidden p-2 rounded-lg hover:bg-white/10 transition-colors\" aria-label=\"Menü öffnen\"><svg class=\"w-6 h-6\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16M4 18h16\"></path></svg></button></div></div></header><main class=\"flex-1\"><div class=\"min-h-screen bg-[var(--neutral-light)]\"><div class=\"bg-gradient-to-br from-[var(--primary)] to-[var(--primary-dark)] text-white py-16\"><div class=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center\"><h1 class=\"text-3xl md:text-5xl font-bold mb-4\" style=\"font-family:Poppins, sans-serif\">Über Moosburg Transparent</h1><p class=\"text-xl text-[var(--secondary)]\">Transparenz schafft Vertrauen.</p></div></div><div class=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12\"><section class=\"card p-8 mb-8\"><h2 class=\"text-2xl font-bold mb-4 text-[var(--primary)]\" style=\"font-family:Poppins, sans-serif\">🎯 Unsere Mission</h2><p class=\"text-[var(--neutral-dark)] leading-relaxed mb-4\">Die Sitzungen des Moosburger Stadtrats sind der zentrale Ort lokalpolitischer demokratischer Entscheidungen – für viele Bürger jedoch schwer zugänglich. Protokolle sind oft unübersichtlich und erst nach längeren Zeiträumen einsehbar, technische Begriffe unverständlich.</p><p class=\"text-[var(--neutral-dark)] leading-relaxed\"><strong>Moosburg Transparent</strong> macht politische Entscheidungen mittels mehrerer Maßnahmen<strong> sichtbarer</strong> und <strong>verständlicher</strong>. Durch digitale, barrierefreie und interaktive Formate wird die Stadtratstätigkeit näher an den Alltag der Bürger gebracht.</p></section><section class=\"card p-8 mb-8\"><h2 class=\"text-2xl font-bold mb-6 text-[var(--primary)]\" style=\"font-family:Poppins, sans-serif\">✨ Was wir bieten</h2><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div class=\"flex gap-4\"><div class=\"w-12 h-12 bg-[var(--secondary)] rounded-xl flex items-center justify-center text-2xl flex-shrink-0\">📝</div><div><h3 class=\"font-semibold mb-1\">Einfache Sprache</h3><p class=\"text-sm text-[var(--neutral-gray)]\">Komplexe Anträge verständlich zusammengefasst – ohne Amtsdeutsch</p></div></div><div class=\"flex gap-4\"><div class=\"w-12 h-12 bg-[var(--secondary)] rounded-xl flex items-center justify-center text-2xl flex-shrink-0\">📊</div><div><h3 class=\"font-semibold mb-1\">Visualisierte Abstimmungen</h3><p class=\"text-sm text-[var(--neutral-gray)]\">Wer hat wie abgestimmt? Übersichtliche Diagramme zeigen es</p></div></div><div class=\"flex gap-4\"><div class=\"w-12 h-12 bg-[var(--secondary)] rounded-xl flex items-center justify-center text-2xl flex-shrink-0\">🗺️</div><div><h3 class=\"font-semibold mb-1\">Interaktive Karte</h3><p class=\"text-sm text-[var(--neutral-gray)]\">Finde Projekte in deinem Stadtteil auf einen Blick</p></div></div><div class=\"flex gap-4\"><div class=\"w-12 h-12 bg-[var(--secondary)] rounded-xl flex items-center justify-center text-2xl flex-shrink-0\">💬</div><div><h3 class=\"font-semibold mb-1\">Bürgerbeteiligung</h3><p class=\"text-sm text-[var(--neutral-gray)]\">Kommentiere und stimme symbolisch ab – deine Meinung zählt!</p></div></div><div class=\"flex gap-4\"><div class=\"w-12 h-12 bg-[var(--secondary)] rounded-xl flex items-center justify-center text-2xl flex-shrink-0\">📱</div><div><h3 class=\"font-semibold mb-1\">Mobile First</h3><p class=\"text-sm text-[var(--neutral-gray)]\">Optimiert für Smartphone – Politik für unterwegs</p></div></div><div class=\"flex gap-4\"><div class=\"w-12 h-12 bg-[var(--secondary)] rounded-xl flex items-center justify-center text-2xl flex-shrink-0\">♿</div><div><h3 class=\"font-semibold mb-1\">Barrierefrei</h3><p class=\"text-sm text-[var(--neutral-gray)]\">Zugänglich für alle – unabhängig von Einschränkungen</p></div></div></div></section><section class=\"card p-8 mb-8\"><h2 class=\"text-2xl font-bold mb-6 text-[var(--primary)]\" style=\"font-family:Poppins, sans-serif\">👥 Das Team</h2><p class=\"text-[var(--neutral-dark)] leading-relaxed mb-6\">Moosburg Transparent ist ein Projekt von Studierenden der Hochschule München im Rahmen des Studiengangs Service Design. Wir arbeiten gemeinsam mit der Stadt Moosburg daran, Kommunalpolitik zugänglicher zu machen.</p><div class=\"bg-[var(--secondary)] rounded-xl p-6 text-center\"><p class=\"text-sm text-[var(--neutral-dark)]\">📚 Entwickelt im Wintersemester 2024/25<br/>🎓 Hochschule München – Service Design<br/>🤝 In Kooperation mit der Stadt Moosburg a.d. Isar</p></div></section><section class=\"card p-8 bg-gradient-to-r from-[var(--primary)] to-[var(--primary-dark)] text-white text-center\"><h2 class=\"text-2xl font-bold mb-4\" style=\"font-family:Poppins, sans-serif\">Mach mit!</h2><p class=\"mb-6 text-[var(--secondary)]\">Entdecke die neuesten Stadtratsentscheidungen und bring dich ein.</p><a class=\"btn-accent inline-block\" href=\"/antraege\">Zu den Anträgen →</a></section></div></div><!--$--><!--/$--></main><footer class=\"bg-[var(--neutral-dark)] text-white mt-auto\"><div class=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12\"><div class=\"grid grid-cols-1 md:grid-cols-4 gap-8\"><div class=\"md:col-span-2\"><div class=\"flex items-center gap-2 mb-4\"><div class=\"w-10 h-10 bg-[var(--primary)] rounded-lg flex items-center justify-center\"><span class=\"text-white font-bold text-xl\">M</span></div><h2 class=\"font-bold text-lg\" style=\"font-family:Poppins, sans-serif\">Moosburg Transparent</h2></div><p class=\"text-gray-400 text-sm leading-relaxed\">Eine Initiative für mehr Transparenz in der Kommunalpolitik. Wir machen Stadtratsentscheidungen verständlich und zugänglich für alle Bürger:innen.</p><p class=\"text-gray-500 text-xs mt-4\">Ein Projekt im Rahmen des Service Design Studiums an der Hochschule München.</p></div><div><h3 class=\"font-semibold mb-4 text-[var(--accent)]\">Navigation</h3><ul class=\"space-y-2 text-sm\"><li><a class=\"text-gray-400 hover:text-white transition-colors\" href=\"/\">Dashboard</a></li><li><a class=\"text-gray-400 hover:text-white transition-colors\" href=\"/antraege\">Alle Anträge</a></li><li><a class=\"text-gray-400 hover:text-white transition-colors\" href=\"/karte\">Stadtkarte</a></li><li><a class=\"text-gray-400 hover:text-white transition-colors\" href=\"/abstimmungen\">Abstimmungen</a></li></ul></div><div><h3 class=\"font-semibold mb-4 text-[var(--accent)]\">Kontakt</h3><ul class=\"space-y-2 text-sm text-gray-400\"><li>📧 info@moosburg-transparent.de</li><li>🏛️ Stadt Moosburg a.d. Isar</li><li>📍 Stadtplatz 13, 85368 Moosburg</li></ul></div></div><div class=\"border-t border-gray-700 mt-8 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500\"><p>© 2024 Moosburg Transparent. Alle Rechte vorbehalten.</p><div class=\"flex gap-6\"><a class=\"hover:text-white transition-colors\" href=\"/impressum\">Impressum</a><a class=\"hover:text-white transition-colors\" href=\"/datenschutz\">Datenschutz</a><a class=\"hover:text-white transition-colors\" href=\"/barrierefreiheit\">Barrierefreiheit</a></div></div></div></footer><script src=\"/_next/static/chunks/cbd55ab9639e1e66.js\" id=\"_R_\" async=\"\"></script><script>(self.__next_f=self.__next_f||[]).push([0])</script><script>self.__next_f.push([1,\"1:\\\"$Sreact.fragment\\\"\\n2:I[2971,[\\\"/_next/static/chunks/8db7249337818e60.js\\\"],\\\"default\\\"]\\n3:I[39756,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/7340adf74ff47ec0.js\\\"],\\\"default\\\"]\\n4:I[37457,[\\\"/_next/static/chunks/ff1a16fafef87110.js\\\",\\\"/_next/static/chunks/7340adf74ff47ec0.js\\\"],\\\"default\\\"]\\n5:I[22016,[\\\"/_next/static/chunks/8db7249337818e60.js\\\"],\\\"\\\"]\\nb:I[68027,[],\\\"default\\\"]\\n:HL[\\\"/_next/static/chunks/4ae24185855008a5.css\\\",\\\"style\\\"]\\n:HL[\\\"/_next/static/media/47fe1b7cd6e6ed85-s.p.855a563b.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/83afe278b6a6bb3c-s.p.3a6ba036.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/8e6fa89aa22d24ec-s.p.3aec397d.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type\\\":\\\"font/woff2\\\"}]\\n:HL[\\\"/_next/static/media/e2334d715941921e-s.p.d82a9aff.woff2\\\",\\\"font\\\",{\\\"crossOrigin\\\":\\\"\\\",\\\"type